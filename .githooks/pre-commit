#!/usr/bin/env bash
set -e

echo "[rrdu hook] Running pre-commit quality checks..."

echo "[rrdu hook] 1/4 Checking code formatting (cargo fmt)..."
cargo fmt --all -- --check

echo "[rrdu hook] 2/4 Running linter (cargo clippy)..."
cargo clippy --all-targets -- -D warnings

echo "[rrdu hook] 3/4 Checking documentation (cargo doc)..."
RUSTDOCFLAGS="-D warnings -D missing_docs" cargo doc --no-deps

echo "[rrdu hook] 4/4 Running tests (cargo test)..."
cargo test --all-targets

echo "[rrdu hook] All pre-commit checks passed successfully!"
